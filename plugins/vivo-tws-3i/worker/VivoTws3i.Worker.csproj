<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RootNamespace>VivoTws3i.Worker</RootNamespace>
    <AssemblyName>VivoTws3i.Worker</AssemblyName>
    <!-- Worker 是独立进程插件，不做自包含发布，避免插件包体积膨胀 -->
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VivoTws3i.Protocol\VivoTws3i.Protocol.csproj" />
    <ProjectReference Include="..\..\..\src\PeripheralBattery.PluginSdk\PeripheralBattery.PluginSdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\profile.json" Link="profile.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
